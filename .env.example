# Notion Internal Integration Secret (starts with ntn_ or secret_)
NOTION_API_KEY=ntn_your_notion_integration_token_here

# Notion Database ID for Job Applications Tracker
# (Found in the database URL: notion.so/workspace/{DATABASE_ID}?v=...)
NOTION_JOB_TRACKER_DB_ID=your_job_tracker_database_id_here

# Optional: Notion Database ID for Project / Ideas Tracker (for future use)
NOTION_PROJECTS_DB_ID=
